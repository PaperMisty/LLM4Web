{
  "manifest_version": 3,
  "name": "LLM4Web AI Assistant",
  "version": "1.0.0",
  "description": "基于 SiliconFlow 与 DeepSeek 官方 API 的轻量级流式 AI 侧边栏/Panel 助手",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 AI 助手"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.css",
        "panel.js",
        "lib/marked.min.js",
        "lib/katex.min.js",
        "lib/katex.min.css",
        "icons/icon-16.png",
        "icons/icon-48.png",
        "icons/icon-128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
